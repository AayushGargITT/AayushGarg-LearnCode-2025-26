{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ResourceMindAI.API"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ResourceMindAi;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Secret": "R6J2oN7hB3qV9xL4mK8wT1cY5pF2sD0zA7uE6nG9rH1jK4vM8qX2tW5yC3bN7pL0",
    "Issuer": "ResourceMindAI",
    "Audience": "ResourceMindAI.Client",
    "ExpirationMinutes": 60,
    "CookieName": "ResourceMindAuth"
  },
  "LLMProvider":{
    "Gemini":"SET_IN_USER_SECRETS"
  },
  "AllowedHosts": "*"
}
